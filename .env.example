# ---------------------------------------------------------------------------
# ReplyBench talks to ONE OpenAI-compatible /chat/completions endpoint.
# The defaults target the Gemini API through its OpenAI-compatible shim, but
# nothing here is Gemini-specific -- point it at OpenAI, Together, or a local
# llama.cpp/vLLM server and it works unchanged.
#
# Gemini key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------

LLM_API_KEY=paste-your-gemini-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- models ---------------------------------------------------------------
# GEN_MODEL   writes suggested replies (the system under test)
# JUDGE_MODEL scores them
# DATA_MODEL  writes the synthetic corpus
#
# HONEST NOTE: on the free tier these are all the same model, which means the
# judge is scoring output from its own model family. That is a real threat to
# validity, not a detail. We do not wave it away -- `replybench validate-metric`
# re-runs a subsample with STRONG_MODEL as an independent judge and reports the
# rank correlation between the two. See README, "Threats to validity".
GEN_MODEL=gemini-2.5-flash-lite
JUDGE_MODEL=gemini-2.5-flash-lite
DATA_MODEL=gemini-2.5-flash-lite

# Better model, tiny free-tier quota (250 req/day). Used only where it buys the
# most: test-split gold replies, and the independent cross-judge check.
STRONG_MODEL=gemini-2.5-flash

# --- throughput -----------------------------------------------------------
# Gemini free tier 429s above ~10-15 concurrent. The client retries with
# backoff, so higher values still complete -- just slower and noisier.
LLM_CONCURRENCY=4

# Per-model daily request caps. The client refuses to exceed these so a run
# cannot silently burn a day's quota. Raise them if you enable billing.
BUDGET_GEMINI_2_5_FLASH=20
BUDGET_GEMINI_2_5_FLASH_LITE=20
EMBED_MODEL=gemini-embedding-001
